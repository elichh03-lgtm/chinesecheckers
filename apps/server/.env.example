DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chinesecheckers
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-prod
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Optional: S3 avatars
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: Sentry, admin tools
# SENTRY_DSN=
# ADMIN_USER_ID=

# Multi-replica deploys: enable Socket.io Redis adapter for cross-replica
# broadcasts. Leave unset for single-process dev/prod.
# SOCKET_REDIS_ADAPTER=true
